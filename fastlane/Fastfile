# frozen_string_literal: true

# tides-swift (Shiomi) と同運用の App Store リリースレーン。
# 認証は App Store Connect API キー（環境変数）+ match (git) を使う。

default_platform(:ios)

platform :ios do
  desc 'Match App Store Provisioning Profiles'
  lane :release_match do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    # Authenticates match against the Developer Portal without an Apple ID.
    setup_app_store_connect_api_key
    match type: 'appstore',
          app_identifier: ['io.ngs.Koikoi'],
          readonly: ENV['MATCH_READONLY'] == 'true'
  end

  desc 'Build app for release'
  lane :release_build do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    release_match

    profile_name = ENV['sigh_io.ngs.Koikoi_appstore_profile-name'] || 'match AppStore io.ngs.Koikoi'
    update_code_signing_settings(
      profile_name: profile_name,
      bundle_identifier: 'io.ngs.Koikoi',
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['Koikoi'],
      build_configurations: %w[Release],
      path: 'Koikoi.xcodeproj'
    )

    # Let gym detect iOS from the destination instead of forcing the SDK.
    require_relative 'patches/gym_module_patch'

    build_app(
      export_method: 'app-store',
      scheme: 'Koikoi',
      destination: 'generic/platform=iOS',
      output_directory: './build/release/ios',
      output_name: 'Koikoi-iOS'
    )
  end

  desc 'Publish app to App Store'
  lane :release_upload do
    setup_app_store_connect_api_key

    pilot(
      skip_waiting_for_build_processing: true,
      ipa: './build/release/ios/Koikoi-iOS.ipa'
    )
  end
  desc 'Fail unless an editable App Store version exists (used by CI to skip metadata delivery)'
  lane :check_editable_version do
    setup_app_store_connect_api_key
    unless has_editable_version?(platform: Spaceship::ConnectAPI::Platform::IOS)
      UI.user_error!('No editable App Store version available')
    end
  end

  desc 'Update App Store metadata'
  lane :deliver_metadata do
    setup_app_store_connect_api_key
    deliver(
      platform: 'ios',
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      metadata_path: './fastlane/metadata',
      # 年齢制限の審査票はアプリ全体の宣言（どのプラットフォームで実行しても反映）
      app_rating_config_path: './fastlane/metadata/app_store_rating_config.json',
      app_identifier: 'io.ngs.Koikoi'
    )
    upload_privacy_details
    declare_content_rights
  end

  # 審査提出に必須の Content Rights（App Information）。deliver は submit_for_review の
  # ときにしか送らないため、メタデータ更新時にアプリ属性として直接書く。
  # 札の絵は購入したストック素材（第三者コンテンツ・利用権あり）なので「含む」を宣言する。
  desc 'Declare that the app uses licensed third-party content (Content Rights Information)'
  lane :declare_content_rights do
    require 'spaceship'
    api_key = Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    UI.user_error!('App Store Connect API key is not configured') if api_key.nil?
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    app = Spaceship::ConnectAPI::App.find('io.ngs.Koikoi')
    UI.user_error!('App not found: io.ngs.Koikoi') if app.nil?
    app.update(attributes: {
      contentRightsDeclaration: Spaceship::ConnectAPI::App::ContentRightsDeclaration::USES_THIRD_PARTY_CONTENT
    })
    UI.success('Content rights declaration set to USES_THIRD_PARTY_CONTENT')
  end

  # このアクションは Apple ID でしか認証できない（API キー非対応）ため、
  # FASTLANE_USER が無い CI では飛ばして手元で実行する。
  desc 'Upload app privacy details (requires FASTLANE_USER; skipped when unset)'
  lane :upload_privacy_details do
    if ENV['FASTLANE_USER'].to_s.empty?
      UI.important('FASTLANE_USER is not set; skipping app privacy details upload')
      next
    end

    upload_app_privacy_details_to_app_store(
      app_identifier: 'io.ngs.Koikoi',
      json_path: './fastlane/app_privacy_details.json',
      skip_json_file_saving: true
    )
  end

  desc 'Upload App Store screenshots from fastlane/screenshots/ios'
  lane :deliver_screenshots do
    setup_app_store_connect_api_key
    deliver(
      platform: 'ios',
      force: true,
      skip_metadata: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      screenshots_path: './fastlane/screenshots/ios',
      app_identifier: 'io.ngs.Koikoi'
    )
  end
end

platform :mac do
  desc 'Create keychain'
  lane :create_ci_keychain do
    create_keychain(
      name: ENV.fetch('KEYCHAIN_NAME', 'tmp.keychain'),
      password: ENV.fetch('KEYCHAIN_PASSWORD', 'tmp'),
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )
  end

  desc 'Match App Store Provisioning Profiles for macOS'
  lane :release_match do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    setup_app_store_connect_api_key
    match(
      type: 'appstore',
      app_identifier: ['io.ngs.Koikoi'],
      platform: 'macos',
      readonly: ENV['MATCH_READONLY'] == 'true'
    )
    # Get Mac Installer Distribution certificate for PKG creation
    match(
      type: 'appstore',
      app_identifier: 'io.ngs.Koikoi',
      platform: 'macos',
      additional_cert_types: 'mac_installer_distribution',
      readonly: ENV['MATCH_READONLY'] == 'true'
    )
  end

  desc 'Build app for macOS release'
  lane :release_build do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    release_match

    profile_name = ENV['sigh_io.ngs.Koikoi_appstore_macos_profile-name'] ||
                   'match AppStore io.ngs.Koikoi macos'
    update_code_signing_settings(
      profile_name: profile_name,
      bundle_identifier: 'io.ngs.Koikoi',
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['Koikoi'],
      build_configurations: %w[Release],
      path: 'Koikoi.xcodeproj'
    )

    build_app(
      export_method: 'app-store',
      scheme: 'Koikoi',
      destination: 'generic/platform=macOS',
      output_directory: './build/release/mac',
      output_name: 'Koikoi-macOS',
      sdk: 'macosx'
    )
  end

  desc 'Publish macOS app to App Store'
  lane :release_upload do
    setup_app_store_connect_api_key

    upload_to_app_store(
      app_identifier: 'io.ngs.Koikoi',
      platform: 'osx',
      pkg: './build/release/mac/Koikoi-macOS.pkg',
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
  desc 'Fail unless an editable App Store version exists (used by CI to skip metadata delivery)'
  lane :check_editable_version do
    setup_app_store_connect_api_key
    unless has_editable_version?(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
      UI.user_error!('No editable App Store version available')
    end
  end

  desc 'Update App Store metadata'
  lane :deliver_metadata do
    setup_app_store_connect_api_key
    deliver(
      platform: 'osx',
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      metadata_path: './fastlane/metadata',
      app_identifier: 'io.ngs.Koikoi'
    )
  end

  desc 'Upload App Store screenshots from fastlane/screenshots/mac'
  lane :deliver_screenshots do
    setup_app_store_connect_api_key
    deliver(
      platform: 'osx',
      force: true,
      skip_metadata: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      screenshots_path: './fastlane/screenshots/mac',
      app_identifier: 'io.ngs.Koikoi'
    )
  end
end

platform :visionos do
  desc 'Match App Store Provisioning Profiles for visionOS (alias to iOS)'
  lane :release_match do
    # visionOS uses iOS provisioning profiles, so just call the iOS lane
    Fastlane::LaneManager.cruise_lane('ios', 'release_match')
  end

  desc 'Build app for visionOS release'
  lane :release_build do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    release_match

    profile_name = ENV['sigh_io.ngs.Koikoi_appstore_profile-name'] || 'match AppStore io.ngs.Koikoi'
    update_code_signing_settings(
      profile_name: profile_name,
      bundle_identifier: 'io.ngs.Koikoi',
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['Koikoi'],
      build_configurations: %w[Release],
      path: 'Koikoi.xcodeproj'
    )

    require_relative 'patches/gym_module_patch'

    build_app(
      export_method: 'app-store',
      scheme: 'Koikoi',
      destination: 'generic/platform=visionOS',
      output_directory: './build/release/visionos',
      output_name: 'Koikoi-visionOS',
      sdk: 'xros'
    )
  end

  desc 'Publish visionOS app to App Store'
  lane :release_upload do
    setup_app_store_connect_api_key

    pilot(
      skip_waiting_for_build_processing: true,
      ipa: './build/release/visionos/Koikoi-visionOS.ipa'
    )
  end

  desc 'Fail unless an editable App Store version exists (used by CI to skip metadata delivery)'
  lane :check_editable_version do
    setup_app_store_connect_api_key
    unless has_editable_version?(platform: Spaceship::ConnectAPI::Platform::VISION_OS)
      UI.user_error!('No editable App Store version available')
    end
  end

  desc 'Update App Store metadata'
  lane :deliver_metadata do
    setup_app_store_connect_api_key
    deliver(
      platform: 'xros',
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      metadata_path: './fastlane/metadata',
      app_identifier: 'io.ngs.Koikoi'
    )
  end

  desc 'Upload App Store screenshots from fastlane/screenshots/visionos'
  lane :deliver_screenshots do
    setup_app_store_connect_api_key
    deliver(
      platform: 'xros',
      force: true,
      skip_metadata: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      screenshots_path: './fastlane/screenshots/visionos',
      app_identifier: 'io.ngs.Koikoi'
    )
  end
end

# 「提出準備中」などメタデータを編集できる状態のバージョンが App Store Connect にあるか。
# 審査中・配信中しか無いときに deliver を走らせると失敗するため、CI はこれで先に判定する。
desc 'Check if an editable App Store version exists for the given platform'
private_lane :has_editable_version? do |options|
  require 'spaceship'

  api_key = Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
  UI.user_error!('App Store Connect API key is not configured') if api_key.nil?
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

  app = Spaceship::ConnectAPI::App.find('io.ngs.Koikoi')
  UI.user_error!('App not found: io.ngs.Koikoi') if app.nil?

  edit_version = app.get_edit_app_store_version(platform: options[:platform])
  if edit_version.nil?
    UI.message("No edit version found for #{options[:platform]}")
    next false
  end

  editable_states = %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED]
  state = edit_version.app_store_state
  if editable_states.include?(state)
    UI.success("Found editable version #{edit_version.version_string} (state: #{state})")
    true
  else
    UI.message("Version #{edit_version.version_string} is not editable (state: #{state})")
    false
  end
end

desc 'Setup AppStore Connect API Key'
lane :setup_app_store_connect_api_key do
  # CI では未設定のシークレットが空文字で入るため、空文字も未設定として扱う
  return if %w[
    APP_STORE_CONNECT_API_KEY_KEY_ID
    APP_STORE_CONNECT_API_KEY_ISSUER_ID
    APP_STORE_CONNECT_API_KEY_KEY
  ].any? { |name| ENV[name].to_s.empty? }

  app_store_connect_api_key(
    key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
    issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
    key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
    is_key_content_base64: ENV['APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64'] == 'true'
  )
end
